alias userSP R0;
userSP = SP;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE +1]*16 + 9] = INT_LOGIN ;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE +1]*16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE +1]*16 + 11]*512 -1 ;

alias username R1;
username = [[PTBR + 2*((userSP-4)/512)]*512 + (userSP -4)%512] ;

alias passwd R2;
passwd = [[PTBR + 2*((userSP-3)/512)]*512 + (userSP -3)%512] ;

alias retAddress R3;
retAddress = [PTBR + 2*((userSP-1)/512)]*512 + (userSP -1)%512 ;

if([SYSTEM_STATUS_TABLE +1] != 1) then
    [retAddress] = -2 ;
else
    alias i R4;
    i = 0;
    while(i < MAX_USER_NUM) do
        if([USER_TABLE + i*2] == username) then
            break;
        endif;
        i = i +1;
    endwhile;

    if(i == MAX_USER_NUM) then
        [retAddress] = -1 ;
    else
        alias encPasswd R5;
        encPasswd = passwd;
        encrypt encPasswd;

        if([USER_TABLE + i*2 +1] != encPasswd) then
            [retAddress] = -1;
        else
            [PROCESS_TABLE + 2*16 + 4] = CREATED;
            [PROCESS_TABLE + 2*16 + 3] = i; //userID

            [PROCESS_TABLE + [SYSTEM_STATUS_TABLE +1]*16 + 4] = WAIT_PROCESS;
            [PROCESS_TABLE + [SYSTEM_STATUS_TABLE +1]*16 + 5] = 2; //Waits for shell process

            [SYSTEM_STATUS_TABLE] = i;

            multipush(R0,R1,R2,R3,R4,R5);
                call SCHEDULER ;
            multipop(R0,R1,R2,R3,R4,R5);

            [retAddress] = 0;
        endif;
    endif;
endif;

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE +1]*16 + 13];
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE +1]*16 + 9] = 0;
ireturn;
