alias funcNum R1 ;
alias currPID R2 ;
alias uap R3 ;

//print "inside mod1 1";

if(funcNum == GET_PCB_ENTRY) then
    alias i R4 ;
    i = 1;
    while(i < 16) do 
        if([PROCESS_TABLE + i*16 + 4] == TERMINATED) then
            break;
        endif;  
        i = i + 1 ;
    endwhile;   
    if(i == 16) then
        R0 = - 1;
    else 
        [PROCESS_TABLE + i*16 + 1] = i ;
        [PROCESS_TABLE + i*16 + 4] = ALLOCATED ;
        [PROCESS_TABLE + i*16 + 14] = PAGE_TABLE_BASE + 20*i ;
        [PROCESS_TABLE + i*16 + 15] = 10 ;
        R0 = i ;
    endif; 
  return;
endif;  

if(funcNum == FREE_USER_AREA_PAGE) then
    uap = [PROCESS_TABLE + currPID*16 + 11];
   // breakpoint;

    alias i R4;
    i = RESOURCE_TABLE_OFFSET;
    while (i < 512) do
        if ([[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 + i] == SEMAPHORE) then 
                multipush(R0, R1, R2, R3, R4);
                    R1 = RELEASE_SEMAPHORE;
                    R2 = [[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 + i + 1];
                    R3 = [SYSTEM_STATUS_TABLE + 1];
                    call RESOURCE_MANAGER;
                multipop(R0, R1, R2, R3, R4);
        else
            if([[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 + i] == FILE) then
                multipush(R0,R1,R2,R3,R4);
                    R1 = CLOSE;
                    R2 = [[PROCESS_TABLE + [SYSTEM_STATUS_TABLE +1]*16 +11]*512 +i+1];
                    call FILE_MANAGER;
                multipop(R0,R1,R2,R3,R4);
            endif;
        endif;
        i = i + 2;
    endwhile;    

    multipush(R1,R2,R3);
    R1 = RELEASE_PAGE;
    R2 = uap ;
    call MOD_2 ;
    multipop(R1,R2,R3);
    return;
endif;

//print "inside mod1 2" ;

if(funcNum == EXIT_PROCESS) then
    multipush(R1,R2,R3);
    R1 = FREE_PAGE_TABLE;
    R2 = currPID ;
    call MOD_1 ;
    multipop(R1,R2,R3);

    multipush(R1,R2,R3);
    R1 = FREE_USER_AREA_PAGE;
    R2 = currPID ;
    call MOD_1 ;
    multipop(R1,R2,R3);

    if([PROCESS_TABLE + currPID*16 + 9]!= 9) then
        alias i R4;
        i=0;
        while(i < 16) do
            if( [PROCESS_TABLE + i*16 + 4] == WAIT_PROCESS && [PROCESS_TABLE + i*16 + 5] == currPID) then
                [PROCESS_TABLE + i*16 + 4] = READY ;
            endif;
            if( [PROCESS_TABLE + i*16 + 2] == currPID ) then
                [PROCESS_TABLE + i*16 + 2] = -1 ;
            endif;
           i = i + 1;
        endwhile;
     endif;   

    [PROCESS_TABLE + currPID*16 + 4] = TERMINATED ;
    return;
endif;

//print "inside mod1 2";

if(funcNum == FREE_PAGE_TABLE) then 
    PTBR  = PAGE_TABLE_BASE + currPID*20 ;

    //Invalidate Library
    [PTBR + 0] = -1;
    [PTBR + 1] = "0000" ;
    [PTBR + 2] = -1;
    [PTBR + 3] = "0000" ;

    alias index R4;
    index = 4; 
    while(index < 20) do
        if([PTBR + index] != -1) then
            multipush(R1,R2,R3);
            R1 = RELEASE_PAGE;
            R2 = [PTBR + index];
            call MOD_2;
            multipop(R1,R2,R3);
            [PTBR + index] = -1;
            [PTBR + index + 1] = "0000";

           //print "in loop" ;

        endif;

        index = index + 2;
    endwhile;
    breakpoint;
    index = 2;
    while(index < 10) do
        if([DISK_MAP_TABLE + currPID*10 + index] != -1) then
            //Check stack or heap
            if((index < 4) || (index > 7)) then
                //Invoke Release block function
                multipush(R1,R2,R3);
                R1 = RELEASE_BLOCK;
                R2 = [DISK_MAP_TABLE + currPID*10 + index];
                R3 = currPID;
                call MOD_2;
                multipop(R1,R2,R3);

             endif;
             [DISK_MAP_TABLE + currPID*10 + index] = -1;
         endif;
         index = index + 1;
    endwhile;
    return;  
endif;

if(funcNum == KILL_ALL) then
    alias i R4;
    i = 0;
    while(i < MAX_FILE_NUM ) do 
        if([INODE_TABLE + i*16 + 1] != -1) then
            multipush(R1,R2,R3,R4);
            R1 = ACQUIRE_INODE;
            R2 = i;
            R3 = currPID;
            call RESOURCE_MANAGER;
            multipop(R1,R2,R3,R4);
        endif;
        i = i +1;
    endwhile;

    i = 2 ;
    while(i < MAX_PROC_NUM-1) do
        if([PROCESS_TABLE + i*16 +1] != currPID && [PROCESS_TABLE+ i*16 + 4] != TERMINATED)then
            multipush(R1,R2,R3,R4);
                R1 = EXIT_PROCESS;
                R2 = i;
                call PROCESS_MANAGER;
            multipop(R1,R2,R3,R4);
        endif;
        i = i +1;
    endwhile;

    i=0;
    while(i < MAX_FILE_NUM) do
        if([INODE_TABLE + i*16 + 1] == 1) then
            multipush(R1,R2,R3,R4);
                R1 = RELEASE_INODE;
                R2 = i;
                R3 = currPID;
                call RESOURCE_MANAGER;
            multipop(R1,R2,R3,R4);
        endif;
        i = i +1;
    endwhile;
    return;
endif;
        



