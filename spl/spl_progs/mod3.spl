alias functionNum R1;

if(functionNum == BUFFERED_READ) then
    alias blockNum R2;
    alias offSet R3;
    alias memAddress R4;
    alias bufferNum R5;
    bufferNum = blockNum % MAX_BUFFER; //MAX_BUFFER = 4 
    
    multipush(R0,R1,R2,R3,R4,R5);
        R1 = ACQUIRE_BUFFER;
        R2 = bufferNum;
        R3 = [SYSTEM_STATUS_TABLE +1];
        call RESOURCE_MANAGER;
    multipop(R0,R1,R2,R3,R4,R5);

    if([BUFFER_TABLE + bufferNum*4 ] != blockNum) then
        if([BUFFER_TABLE + bufferNum*4 + 1] == 1) then
            multipush(R0,R1,R2,R3,R4,R5);
                R1 = DISK_STORE;
                R2 = [SYSTEM_STATUS_TABLE +1];
                R3 = 71 + bufferNum ;
                R4 = [BUFFER_TABLE + bufferNum*4] ;
                call DEVICE_MANAGER;
            multipop(R0,R1,R2,R3,R4,R5);
            [BUFFER_TABLE + bufferNum*4 + 1] = 0 ;

        endif;

        multipush(R0,R1,R2,R3,R4,R5);
            R1 = DISK_LOAD ;
            R4 = blockNum ;
            R2 = [SYSTEM_STATUS_TABLE +1];
            R3 = 71 + bufferNum ;
            call DEVICE_MANAGER;
        multipop(R0,R1,R2,R3,R4,R5);

        [BUFFER_TABLE + bufferNum*4] = blockNum;
    endif;

    [memAddress] = [(71 + bufferNum)* 512 + offSet];

    multipush(R0,R1,R2,R3,R4,R5);
        R1 = RELEASE_BUFFER ;
        R2 = bufferNum;
        R3 = [SYSTEM_STATUS_TABLE + 1];
        call RESOURCE_MANAGER ;
    multipop(R0,R1,R2,R3,R4,R5);

    return;
endif;

if(functionNum == OPEN) then
    alias fileName R2;
    alias i R3;
    i=0;
    while(i < MAX_FILE_NUM) do
        if(fileName == [INODE_TABLE + i*16 + 1]) then
            break;
        endif;
        i = i + 1;
    endwhile;
    
    if(i == MAX_FILE_NUM) then
        R0 = -1;
    else
        alias retValue R4;
        multipush(R0,R1,R2,R3);
            R1 = ACQUIRE_INODE;
            R2 = i;
            R3 = [SYSTEM_STATUS_TABLE +1];
            call RESOURCE_MANAGER;
            retValue = R0;
        multipop(R0,R1,R2,R3);
        
        if(retValue == -1) then
            R0 = -1;
        else
            if([INODE_TABLE + i*16] == EXEC) then
                multipush(R0,R1,R2,R3,R4);
                    R1 = RELEASE_INODE;
                    R2 = i;
                    R3 = [SYSTEM_STATUS_TABLE +1];
                    call RESOURCE_MANAGER;
                multipop(R0,R1,R2,R3,R4);
                R0 = -1;
            else
                alias openFTindex R5;
                openFTindex = 0;
                while(openFTindex < MAX_OPENFILE_NUM) do
                    if([OPEN_FILE_TABLE + openFTindex*4 ] == -1) then
                        break;
                    endif;
                    openFTindex = openFTindex + 1;
                endwhile;

                if(openFTindex == MAX_OPENFILE_NUM) then
                    R0 = -2;
                else
                    if(fileName == "root") then
                        [OPEN_FILE_TABLE + openFTindex*4] = INODE_ROOT ;
                    else
                        if([FILE_STATUS_TABLE + i*4 + 1] == -1) then
                            [FILE_STATUS_TABLE + i*4 + 1] = 1;
                        else
                            [FILE_STATUS_TABLE + i*4 +1] = [FILE_STATUS_TABLE + i*4 +1] + 1 ;
                        endif;
                        [OPEN_FILE_TABLE + openFTindex*4 ] = i;
                    endif;
                    [OPEN_FILE_TABLE + openFTindex*4 + 1] = 1;
                    [OPEN_FILE_TABLE + openFTindex*4 + 2] = 0;
                    
                    //print openFTindex ;

                    multipush(R0,R1,R2,R3,R4,R5);
                        R1 = RELEASE_INODE;
                        R2 = i;
                        R3 = [SYSTEM_STATUS_TABLE +1];
                        call RESOURCE_MANAGER;
                    multipop(R0,R1,R2,R3,R4,R5);
                    R0 = openFTindex;
                   
                endif;
            endif;
        endif;
    endif;
endif;

if(functionNum == CLOSE) then
    alias openFTindex R2;
    alias inodeIndex R3;

    inodeIndex = [OPEN_FILE_TABLE + openFTindex*4];
    [OPEN_FILE_TABLE + openFTindex*4 + 1] = [OPEN_FILE_TABLE + openFTindex*4 + 1] - 1;

    if([OPEN_FILE_TABLE + openFTindex*4 +1] == 0) then
        alias i R4 ;
        i = 0;
        while(i < 4) do
            [OPEN_FILE_TABLE + i*4 + 1] = -1 ;
            i = i +1;
        endwhile;

        if(inodeIndex != INODE_ROOT) then
            [FILE_STATUS_TABLE + inodeIndex*4 + 1] = [FILE_STATUS_TABLE + inodeIndex*4 + 1] -1 ;
            if([FILE_STATUS_TABLE + inodeIndex*4 + 1] == 0) then
                [FILE_STATUS_TABLE + inodeIndex*4 + 1] = -1;
            endif;
        endif;
    endif;
endif;


return;
