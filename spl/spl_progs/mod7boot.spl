loadi(61,2); //Loading disk free list

loadi (63,13); //Loading library
loadi (64,14);

loadi (4,17); //Loading Timer Interrupt
loadi (5,18);

loadi (65,7); //Loading INIT Program

loadi (22,35); //Interrupt10 : Exit syscall
loadi (23,36);

loadi(2,15); //Exception Handler
loadi(3,16);

loadi(16,29); //Loading INT7 i.e Syscall for Write
loadi(17,30);

//loadi(69,11); //Loading Idle Code
//loadi(70,12);

loadi(54,67); //Loading the boot module i.e (module 7)
loadi(55,68);

loadi(50,63); //Loading Module 5, Scheduler/Context switch module
loadi(51,64);

loadi(40,53); //Loading Module 0, Resource Manager
loadi(41,54);

loadi(48,61); //Loading Module 4, Device Manager
loadi(49,62);

loadi(8,21); //Loading Console Interrupt routine
loadi(9,22);

loadi(14,27); //Loading INT6, Terminal Read
loadi(15,28);

loadi(20,33); //Loading INT9, Exec System Call
loadi(21,34);

loadi(42,55); //Loading Module 1, Process Manager
loadi(43,56);

loadi(44,57); //Loading Module 2, Memory Manager
loadi(45,58);

loadi(59,3); //Loading Inode + User Table
loadi(60,4);

loadi(6,19); //Loading Disk INT routine
loadi(7,20);

loadi(18,31); // Fork syscall/ Interrupt 8 routine
loadi(19,32);

loadi(24,37); // INT 11/ Signal,Wait,getpid,getppid
loadi(25,38);

loadi(32,45); // INT 15/ Shutdown syscall
loadi(33,46);

loadi(28,41); // INT 13/Semget, Semrelease
loadi(29,42);

loadi(30,43); // INT 14/ Semlock, Semunlock
loadi(31,44);

loadi(10,23); // INT 4/ Create File
loadi(11,24);

loadi(62,5); // Copy of Root file

loadi(12,25); //INT 5
loadi(13,26);

loadi(46,59); //Module 3/ File Manager
loadi(47,60);

loadi(67,9); //Shell code
loadi(68,10);

loadi(26,39); // INT 12 / Logout syscall
loadi(27,40);

loadi(36,49); // INT 17 / Login syscall
loadi(37,50);

loadi(34,47); //INT 16 / newusr,remusr,setpwd,getuname,getuid
loadi(35,48);


alias i R0;
alias fileStatusTable R9;
fileStatusTable = FILE_STATUS_TABLE ;
i=0;
while(i < MAX_FILE_NUM) do
    [fileStatusTable + i*4] = -1;
    [fileStatusTable + i*4 +1] = -1;
    i = i + 1;
endwhile;

i=0;
alias bufferTable R10;
bufferTable = BUFFER_TABLE;
while(i < MAX_BUFFER) do
    [bufferTable + i*4 + 0] = -1;
    [bufferTable + i*4 + 1] = 0;
    [bufferTable + i*4 + 2] = -1;
    i =i + 1;
endwhile;  

i=0;
while(i < MAX_OPENFILE_NUM) do
    [OPEN_FILE_TABLE + i*4 + 0] = -1;
    [OPEN_FILE_TABLE + i*4 + 1] = 0 ;
    i = i + 1;
endwhile;

[SYSTEM_STATUS_TABLE + 2] = 0 ; 

i=0;
while(i < 128) do
    if(i < 83) then
        [MEMORY_FREE_LIST + i] = 1 ;
    else 
        [MEMORY_FREE_LIST + i] = 0 ;
        [SYSTEM_STATUS_TABLE + 2] = [SYSTEM_STATUS_TABLE + 2] + 1;
    endif;
  i = i + 1;
endwhile;  
 
[TERMINAL_STATUS_TABLE +1] = 0; //Indicates that the terminal is free before scheduling the first process

//Initializing the per-process Resource table of init
i=0;
alias init_perprocess R1 ;

init_perprocess = [PROCESS_TABLE + 16 +11]*512 + RESOURCE_TABLE_OFFSET ;

while(i < 16)do
    [init_perprocess + i] = -1 ;
    i = i +2 ;
endwhile;

i=0;
alias semTable R8;
semTable = SEMAPHORE_TABLE ;
while(i < MAX_SEM_COUNT) do
    [semTable + i*4] = -1 ;
    [semTable + i*4 +1] = 0 ;
    i = i + 1;
endwhile;    

PTBR = PAGE_TABLE_BASE + 20; //For init process. As idle occupies PTBR
PTLR = 10 ;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";

//Code
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0000";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 66;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";

alias processTable R3;
processTable = PROCESS_TABLE + 16 ;

[processTable+ 1] =1 ; //PID is 1 for init process
[processTable+ 3] = 0; // USERID of root is 1 
[processTable + 4] = CREATED ; //As the first scheduled process is Idle code
[processTable+ 13] = 8*512 ; //Same because the Stack is residing in logical page 8 of virtual mem
[processTable+ 12] = 0 ; //KPTR value is set to 0 as always
[processTable+ 14] = PTBR ; //The current value of PTBR is set to PTBR + 20
[processTable+ 15] = 10 ; //As always 10(ABI convention)
[processTable + 11] = 77 ; //Setting the user area page as 77
[66 * 512] = [65 * 512 + 1] ;

//Initialization for shell process 

PTBR = PAGE_TABLE_BASE + 40 ;

[PTBR + 0] = 63;
[PTBR + 1] = "0100";
[PTBR + 2] = 64;
[PTBR + 3] = "0100";

[PTBR + 4] = -1;
[PTBR + 5] = "0000";
[PTBR + 6] = -1;
[PTBR + 7] = "0000";

[PTBR + 8] = 67;
[PTBR + 9] = "0100";
[PTBR + 10] = 68;
[PTBR + 11] = "0100";
[PTBR + 12] = -1;
[PTBR + 13] = "0000";
[PTBR + 14] = -1;
[PTBR + 15] = "0000";

[PTBR + 16] = 78;
[PTBR + 17] = "0110";
[PTBR + 18] = 79;
[PTBR + 19] = "0110";

[78 * 512] = [67 * 512 + 1]  ;

processTable  = PROCESS_TABLE + 32 ;

[processTable + 1] = 2 ; //PID is 2 for shell process
[processTable + 2] = 1 ; //PPID as 1
[processTable + 3] = 1; // USERID of root is 1 
[processTable + 4] = TERMINATED ; //As the first scheduled process is Idle code
[processTable + 13] = 8*512 ; //Same because the Stack is residing in logical page 8 of virtual mem
[processTable + 12] = 0 ; //KPTR value is set to 0 as always
[processTable + 14] = PTBR ; //The current value of PTBR is set to PTBR + 40
[processTable + 15] = 10 ; //As always 10(ABI convention)
[processTable + 11] = 80 ; //Setting the user area page as 80

alias diskMapTable R5;
diskMapTable = DISK_MAP_TABLE + 20 ;
[diskMapTable + 0] = -1;            // Unused
[diskMapTable + 1] = -1;            // Unused
[diskMapTable + 2] = -1;            // Heap 1
[diskMapTable + 3] = -1;            // Heap 2
[diskMapTable + 4] =  9;            // Code 1
[diskMapTable + 5] =  10;            // Code 2
[diskMapTable + 6] = -1;            // Code 3
[diskMapTable + 7] = -1;            // Code 4
[diskMapTable + 8] = -1;            // Stack 1
[diskMapTable + 9] = -1;            // Stack 2

[MEMORY_FREE_LIST + 78] = 1;
[MEMORY_FREE_LIST + 79] = 1;
[MEMORY_FREE_LIST + 80] = 1;

i = 3;
alias ProcessTable R6;
processTable = PROCESS_TABLE ;
while (i < 16) do
    [ProcessTable + 16 * i + 4] = TERMINATED;
    i = i + 1;
endwhile;

[TERMINAL_STATUS_TABLE] = 0;
[DISK_STATUS_TABLE] = 0;
[SYSTEM_STATUS_TABLE + 2] = 47;
[SYSTEM_STATUS_TABLE + 3] = 0;

return;

