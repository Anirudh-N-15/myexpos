[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 9] = 7 ;

alias userSP R0 ;
userSP = SP;

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 13] = SP; 
SP=[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 11]*512 - 1; 

alias filed R1;
filed = [[PTBR + 2*((userSP-4)/512)]*512 + (userSP-4)%512] ;

alias retAddress R2;
retAddress = [PTBR + 2*((userSP-1)/512)]*512 + (userSP-1)%512 ;

if(filed == -1) then
    alias wordaddr R3 ;
	wordaddr = [([PTBR + 2*((userSP-3)/512)]) * 512 + (userSP-3)%512] ;
	multipush(R0,R1,R2,R3);
	R1 = TERMINAL_READ;
	R2 = [SYSTEM_STATUS_TABLE+1] ;
	R3 = wordaddr ;
	call MOD_4 ;
	multipop(R0,R1,R2,R3);
    [retAddress] = 0;
endif;

if(filed != -1) then

    if(filed < 0 || filed > 7) then
        [retAddress] = -1 ;
    else
        alias RTentry R3 ;
        RTentry = [PROCESS_TABLE +[SYSTEM_STATUS_TABLE+1]*16 +11]*512 + RESOURCE_TABLE_OFFSET +filed*2;

        if([RTentry] != FILE)then
            [retAddress] = -1;
        else
            alias inodeIndex R4;
            alias openFTindex R5;
            openFTindex = [RTentry +1];
            inodeIndex = [OPEN_FILE_TABLE + openFTindex*4];

            breakpoint;

            multipush(R0,R1,R2,R3,R4,R5);
                R1 = ACQUIRE_INODE;
                R2 = inodeIndex;
                R3 = [SYSTEM_STATUS_TABLE +1];
                call RESOURCE_MANAGER ;
                R9 = R0;
            multipop(R0,R1,R2,R3,R4,R5);

            if(R9 == -1) then
                [retAddress] = -1;
            else
                alias lseek R6;
                lseek = OPEN_FILE_TABLE + openFTindex*4 + 2;

                alias wordAddress R7;
                wordAddress = [[PTBR + 2*((userSP - 3)/512)]*512 + (userSP-3)%512] ;
                wordAddress = [PTBR + 2*(wordAddress/512)]*512 + wordAddress%512 ;

                if(inodeIndex == INODE_ROOT) then
                    if( [lseek] == 480 ) then
                        [retAddress] = -2;
                    else
                        [wordAddress] = [ROOT_FILE + [lseek]];
                        [lseek] = [lseek] + 1;
                        [retAddress] = 0;
                    endif;
                else
                    if([lseek] == [INODE_TABLE + inodeIndex*16 + 2]) then                        
                        [retAddress] = -2;
                    else   
                        alias blockNum R8;
                        alias offset R9;
                        blockNum = [INODE_TABLE + inodeIndex*16 +8 +([lseek] / 512)];
                        offset = [lseek] % 512 ;

                        multipush(R0,R1,R2,R3,R4,R5,R6,R6,R7,R8,R9);
                            R1 = BUFFERED_READ;
                            R2 = blockNum;
                            R3 = offset;
                            R4 = wordAddress ;
                            call FILE_MANAGER;
                        multipop(R0,R1,R2,R3,R4,R5,R6,R6,R7,R8,R9);

                        [lseek] = [lseek] + 1;
                        [retAddress] = 0;
                    endif;
                endif;
                    multipush(R0,R1,R2,R3,R4,R5,R6,R7,R8,R9);
                        R1 = RELEASE_INODE;
                        R2 = inodeIndex;
                        R3 = [SYSTEM_STATUS_TABLE +1];
                        call RESOURCE_MANAGER;
                    multipop(R0,R1,R2,R3,R4,R5,R6,R7,R8,R9);
            endif;
        endif;
    endif;
endif;                        

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 9] = 0 ;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1]*16 + 13];
ireturn;
