int main(){
    decl
        int temp,fd;
        str filename;
    enddecl

    begin
        fd = exposcall("Open","root");

        while(1 == 1) do
            temp = exposcall("Read",fd,filename);

            if(temp == -2) then
                break;
            endif;
            temp = exposcall("Seek",fd,7);
            
            if(filename == "-1") then
                continue;
            endif;

            temp = exposcall("Write", -2, filename);
        endwhile;
        return 0;

    end
}
